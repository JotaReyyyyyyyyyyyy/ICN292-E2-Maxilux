# Juan Pablo: ejecutar node instalar.mjs preparar y editar privado/config.env.
# Poner entre comillas los valores con # o espacios. Cada valor ocupa una línea.
MAXILUX_API_TOKEN=CAMBIAR_POR_32_O_MAS_CARACTERES_ALEATORIOS
PORT=8787
BIND_HOST=0.0.0.0
DATA_FILE=datos/maxilux.sqlite
TEST_MODE=true
TEST_RECIPIENT=
DELIVERY_MODE=drafts
BATCH_SIZE=10
FOLLOWUP_DAYS=3
FOLLOWUP_BUSINESS_DAYS=true
MAX_FOLLOWUPS=1

# Proyecto Google controlado por Maxilux. OAuth: Sheets + Drive.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SHEETS_BACKEND=google

# OpenAI gpt-6-luna por defecto (reasoning.effort=medium); puede cambiarse a gemini.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=
# Reserva conservadora de consumo en USD por mes calendario (configurar por JP).
LLM_BUDGET_USD=5.00

# Correo de hosting, aunque Ariel lo abra desde Outlook. Solo IMAP, sin SMTP.
MAIL_BACKEND=imap
MAIL_FROM=
MAIL_NAME=Ariel Godoy
# Opcional: completar con https://maxilux.cl/ cuando se confirme que la web está publicada.
MAIL_WEBSITE=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_DRAFTS_FOLDER=Drafts
IMAP_SENT_FOLDER=Sent
IMAP_INBOX_FOLDER=INBOX

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reporte PDF con la base LaTeX; Docker ya incluye el compilador.
REPORT_LATEX_BIN=pdflatex
REPORT_CURRENT_PERIOD=false
# REPORT_DIR opcional; por defecto, reportes/ junto a DATA_FILE.

# n8n self-hosted: conservar llave y volumen en toda migración.
N8N_ENCRYPTION_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DISTINTO
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
